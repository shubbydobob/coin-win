<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  테스트 소스용 Checkstyle 설정.

  프로덕션 설정(checkstyle.xml)과 딱 두 군데만 다르다.

  1. MethodLength 40 / FileLength 400 로 완화
     한글 given/when/then 이름과 경계값 나열이 20줄을 넘기기 쉽다.
     conventions.md 의 20/200 은 프로덕션 코드의 책임 분리를 겨냥한 수치다.

  2. MethodName 이 한글 식별자와 대문자 시작을 허용
     testing.md 가 "도메인 규칙이 문장으로 읽혀야 한다"며 한글 테스트 이름을 요구한다.
     그 문장은 타입·상수 이름으로 시작하는 일이 잦다 (LONG_포지션은_..., BigDecimal로도_...).

  순환 복잡도(8) · 파라미터 개수(4) · 중첩 깊이(3) 는 테스트에도 동일하게 적용한다.
  근거는 .claude/docs/conventions.md 복잡도 한계표 아래에 기록되어 있다.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>

  <module name="FileLength">
    <property name="max" value="400"/>
  </module>

  <module name="TreeWalker">

    <module name="MethodLength">
      <property name="max" value="40"/>
      <property name="countEmpty" value="false"/>
    </module>

    <!-- 아래 세 가지는 프로덕션과 동일하게 유지한다. -->
    <module name="ParameterNumber">
      <property name="max" value="4"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="8"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="3"/>
    </module>
    <module name="NestedForDepth">
      <property name="max" value="3"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="3"/>
    </module>

    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="IllegalImport"/>

    <module name="EmptyBlock">
      <property name="option" value="text"/>
    </module>
    <module name="NeedBraces"/>
    <module name="OneStatementPerLine"/>
    <module name="UpperEll"/>

    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <!--
      한글 테스트 이름 허용. 예: 롱_포지션은_손절가가_최저_진입가보다_낮아야_한다()
      대문자 시작도 허용한다. 테스트 이름은 도메인 문장이라 타입·상수 이름으로 시작하는 것이
      자연스럽기 때문이다. 예: LONG_포지션은_..., BigDecimal로도_...
    -->
    <module name="MethodName">
      <property name="format" value="^[A-Za-z가-힣][\w가-힣]*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z가-힣][\w가-힣]*$"/>
    </module>
    <module name="MemberName"/>
    <module name="ConstantName"/>
  </module>
</module>
