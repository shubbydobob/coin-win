<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs 억제 필터.

  빈 상태로 시작한다. 억제는 실제로 오탐이 발생했을 때, 왜 오탐인지 주석과 함께 추가한다.
  "빌드를 통과시키기 위해" 추가하지 않는다.

  억제는 클래스와 필드까지 좁혀서 적는다. 패키지 단위로 넓게 열면 나중에 진짜 문제가
  같은 그물에 걸려 조용히 빠져나간다. 어댑터가 늘 때마다 한 줄씩 늘어나는 것이 정상이다.
-->
<FindBugsFilter>

  <!--
    EI_EXPOSE_REP2 — "외부에서 받은 가변 객체를 필드에 저장한다".

    생성자 주입한 Spring 협력 객체에 대해서는 오탐이다. JdbcTemplate 은 스레드 안전한
    싱글턴이고, 복사본을 저장하라는 이 경고의 처방이 애초에 성립하지 않는다. 주입하지
    않으려면 어댑터가 DataSource 를 스스로 만들어야 하는데 그것이 훨씬 나쁘다.

    억제 범위를 필드 하나로 좁힌 이유: 같은 클래스가 나중에 호출자에게서 받은 List 를
    그대로 들고 있게 되면 그때는 진짜 문제이고, 그 경고는 여전히 잡혀야 한다.
  -->
  <Match>
    <Class name="com.coinwin.market.adapter.out.persistence.JdbcCandleAdapter"/>
    <Field name="jdbc"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- 같은 이유. RestClient 는 불변이고 스레드 안전하도록 만들어진 타입이다. -->
  <Match>
    <Class name="com.coinwin.market.adapter.out.binance.BinanceCandleAdapter"/>
    <Field name="client"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <Match>
    <Class name="com.coinwin.market.adapter.out.binance.BinanceMarketMetricsAdapter"/>
    <Field name="client"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    같은 이유 — 거래소 포지션 어댑터. RestClient 는 불변이고 스레드 안전하다.

    Clock 은 여기서 빼지 않았다. 경고가 나지 않기 때문이기도 하고, 난다면 그때는 진짜로
    한 번 생각해 볼 자리이기 때문이다 — 가변 시계를 주입받아 들고 있는 것은 서명
    타임스탬프에 영향을 준다.

    시크릿(BinanceCredentials)도 여기 없다. 그 필드는 String 이라 애초에 이 경고의
    대상이 아니다.
  -->
  <Match>
    <Class name="com.coinwin.account.adapter.out.binance.BinancePositionAdapter"/>
    <Field name="client"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!--
    같은 이유 — Phase 5 의 JPA 어댑터. EntityManager 는 Spring 이 주입하는 스레드 바인딩
    프록시이고 JPAQueryFactory 는 그 프록시를 감싼 얇은 팩토리다. 둘 다 복사하라는 처방이
    성립하지 않는다. 특히 EntityManager 는 복사본을 만드는 순간 트랜잭션 경계 밖의
    영속성 컨텍스트가 생겨 저장이 조용히 반영되지 않는다.
  -->
  <Match>
    <Class name="com.coinwin.journal.adapter.out.persistence.JpaTradeAdapter"/>
    <Or>
      <Field name="entityManager"/>
      <Field name="queryFactory"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

</FindBugsFilter>
